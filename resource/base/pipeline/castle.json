{
    "Func_CastleResource": {
        "attach": {
            "description": "功能：城堡资源记录（粮食存量 / 可调配量），低于阈值时可暂停任务"
        },
        "recognition": "DirectHit",
        "action": "Custom",
        "custom_action": "CastleResourceProcessor",
        "post_delay": 500,
        "timeout": 180000
    },
    "Func_BuyBread": {
        "attach": {
            "description": "功能：市场购买面包（全部 / 指定数量）"
        },
        "recognition": "DirectHit",
        "action": "Custom",
        "custom_action": "BreadPurchaseProcessor",
        "post_delay": 500,
        "timeout": 600000
    },
    "CastleResourceRecordMonth": {
        "attach": {
            "description": "城堡资源记录月份：0=不记录，1-12=年度任务到该月自动记录"
        },
        "recognition": "OCR",
        "expected": [
            "0"
        ],
        "roi": [
            0,
            0,
            1,
            1
        ],
        "timeout": 1000,
        "enabled": true
    },
    "CastleFoodThreshold": {
        "attach": {
            "description": "粮食阈值：城堡「粮食存量」低于该值时暂停年度任务，0=不检查"
        },
        "recognition": "OCR",
        "expected": [
            "0"
        ],
        "roi": [
            0,
            0,
            1,
            1
        ],
        "timeout": 1000,
        "enabled": true
    },
    "CastleSilverThreshold": {
        "attach": {
            "description": "银币阈值：城堡「可调配量」低于该值时暂停年度任务，0=不检查"
