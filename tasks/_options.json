    "开启好娃提醒": {
        "type": "checkbox",
        "description": "是否开启好娃提醒,提醒时弹窗并结束任务",
        "cases": [
            {
                "name": "科内塔之怒",
                "description": "技巧SS + 力量S + 意志或敏捷有一个0.3以上 + 科内塔之怒",
                "pipeline_override": {
                    "检测_科内塔之怒": {
                        "enabled": true
                    }
                }
            },
            {
                "name": "太阳+科内塔之怒",
                "description": "技巧SS + 力量S + 意志或敏捷有一个0.3以上 + 太阳之子 + 科内塔之怒",
                "pipeline_override": {
                    "检测_太阳+科内塔之怒": {
                        "enabled": true
                    }
                }
            },
            {
                "name": "上自专",
                "description": "高等精灵顶级三特性：上古灵性 + 自然共感 + 专注之眸，不看属性",
                "pipeline_override": {
                    "检测_上自专": {
                        "enabled": true
                    }
                }
            },
            {
                "name": "欧里克神力+同类相食",
                "description": "欧里克的神力 + 同类相食，高力技兼顾偏斜生存，不看属性",
                "pipeline_override": {
                    "检测_欧里克神力+同类相食": {
                        "enabled": true
                    }
                }
            },
            {
                "name": "新组合 5",
                "description": "启用「新组合 5」提醒",
                "pipeline_override": {
                    "检测_新组合5": {
                        "enabled": true
                    }
                }
            }
        ],
        "default_case": [
            "科内塔之怒",
            "太阳+科内塔之怒"
        ]
    },
    "开启生娃自动起名": {
        "type": "switch",
