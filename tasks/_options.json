{
    "DailyTaskSubTaskSwitch": {
        "type": "checkbox",
        "description": "是否自动处理每日任务",
        "cases": [
            {
                "name": "购买市场折扣物品",
                "description": "是否自动购买市场折扣物品",
                "pipeline_override": {
                    "BigMapMarket": {
                        "enabled": true
                    }
                }
            },
            {
                "name": "商城免费礼包",
                "description": "是否自动购买商城免费礼包",
                "pipeline_override": {
                    "BigMapMall": {
                        "enabled": true
                    }
                }
            },
            {
                "name": "悬赏令领取",
                "description": "是否自动领取悬赏令",
                "pipeline_override": {
                    "BigMapRewardToken": {
                        "enabled": true
                    }
                }
            }
        ],
        "default_case": [
            "购买市场折扣物品",
            "商城免费礼包",
            "悬赏令领取"
        ]
    },
    "4月城堡相亲": {
        "type": "select",
        "description": "4月城堡相亲（城堡-城堡主厅-联姻）：自动 / 跳过 / 手动",
        "default_case": "自动",
        "cases": [
            {
                "name": "自动",
                "description": "自动执行城堡主厅相亲",
                "pipeline_override": {
                    "Flag_EnableAprCastleMarry": {
                        "enabled": true
                    },
                    "Flag_AprCastleManual": {
                        "enabled": false
                    }
                }
            },
            {
                "name": "跳过",
                "description": "4月不做相亲",
                "pipeline_override": {
                    "Flag_EnableAprCastleMarry": {
                        "enabled": false
                    },
                    "Flag_AprCastleManual": {
                        "enabled": false
                    }
                }
            },
            {
                "name": "手动",
                "description": "弹窗提示并暂停任务，由玩家手动处理",
                "pipeline_override": {
                    "Flag_EnableAprCastleMarry": {
                        "enabled": false
                    },
                    "Flag_AprCastleManual": {
                        "enabled": true
                    }
                }
            }
        ]
    },
    "5月春林节相亲": {
        "type": "select",
        "description": "5月春林节相亲暂未实现自动流程，只能选择 跳过 / 手动",
        "default_case": "跳过",
        "cases": [
            {
                "name": "跳过",
                "description": "5月春林节不做相亲，继续推月",
                "pipeline_override": {
                    "Flag_EnableMaySpringMarry": {
                        "enabled": false
                    },
                    "Flag_MaySpringManual": {
                        "enabled": false
                    }
                }
            },
            {
                "name": "手动",
                "description": "弹窗提示并暂停任务，由玩家手动处理",
                "pipeline_override": {
                    "Flag_EnableMaySpringMarry": {
                        "enabled": false
                    },
                    "Flag_MaySpringManual": {
                        "enabled": true
                    }
                }
            }
        ]
    },
    "开启3月启航节购买": {
        "type": "switch",
        "description": "是否开启3月启航节自动购买物品",
        "cases": [
            {
                "name": "Yes",
                "description": "开启3月启航节自动购买",
                "pipeline_override": {
                    "Flag_EnableSailingFestivalPurchase": {
                        "enabled": true
                    }
                }
            },
            {
                "name": "No",
                "description": "关闭3月启航节自动购买",
                "pipeline_override": {
                    "Flag_EnableSailingFestivalPurchase": {
                        "enabled": false
                    }
                }
            }
        ],
        "default_case": "Yes"
    },
    "开启好娃提醒": {
        "type": "checkbox",
        "description": "是否开启好娃提醒,提醒时弹窗并结束任务",
        "cases": [
            {
                "name": "科内塔之怒",
                "description": "技巧SS + 力量S + 意志或敏捷有一个0.3以上 + 科内塔之怒",
                "pipeline_override": {
                    "检测_科内塔之怒": {
                        "enabled": true
                    }
                }
            },
            {
                "name": "太阳+科内塔之怒",
                "description": "技巧SS + 力量S + 意志或敏捷有一个0.3以上 + 太阳之子 + 科内塔之怒",
                "pipeline_override": {
                    "检测_太阳+科内塔之怒": {
                        "enabled": true
                    }
                }
            },
            {
                "name": "上自专",
                "description": "高等精灵顶级三特性：上古灵性 + 自然共感 + 专注之眸，不看属性",
                "pipeline_override": {
                    "检测_上自专": {
                        "enabled": true
                    }
                }
            },
            {
                "name": "欧里克神力+同类相食",
                "description": "欧里克的神力 + 同类相食，高力技兼顾偏斜生存，不看属性",
                "pipeline_override": {
                    "检测_欧里克神力+同类相食": {
                        "enabled": true
                    }
                }
            },
            {
                "name": "新组合 5",
                "description": "启用「新组合 5」提醒",
                "pipeline_override": {
                    "检测_新组合5": {
                        "enabled": true
                    }
                }
            }
        ],
        "default_case": [
            "科内塔之怒",
            "太阳+科内塔之怒"
        ]
    },
    "开启生娃自动起名": {
        "type": "switch",
        "description": "佣兵生娃事件后是否自动识别属性并起名（关闭则保留游戏默认名字）",
        "cases": [
            {
                "name": "Yes",
                "description": "开启自动起名：识别属性 + 命名 + 好苗子检测",
                "pipeline_override": {
                    "Flag_AutoNameChild": {
                        "enabled": true
                    }
                }
            },
            {
                "name": "No",
                "description": "关闭自动起名：直接点确认，保留游戏默认名字",
                "pipeline_override": {
                    "Flag_AutoNameChild": {
                        "enabled": false
                    }
                }
            }
        ],
        "default_case": "Yes"
    },
    "开启自动接受佣兵": {
        "type": "select",
        "description": "自动接受加入的佣兵：全部接受 / 智能接受（按名字规则） / 不自动接受",
        "cases": [
            {
                "name": "No",
                "description": "不自动接受：直接点取消",
                "pipeline_override": {
                    "Flag_SmartMercenary": {
                        "enabled": false
                    },
                    "Event_MercenaryJoin": {
                        "next": [
                            "Event_MercenaryJoinCancel"
                        ]
                    }
                }
            },
            {
                "name": "Yes",
                "description": "全部接受：直接点招募",
                "pipeline_override": {
                    "Flag_SmartMercenary": {
                        "enabled": false
                    },
                    "Event_MercenaryJoin": {
                        "next": [
                            "Event_MercenaryJoinConfirm"
                        ]
                    }
                }
            },
            {
                "name": "智能",
                "description": "智能接受：佣兵名字命中 table/mercenary_rules.json 才接受",
                "pipeline_override": {
                    "Flag_SmartMercenary": {
                        "enabled": true
                    },
                    "Event_MercenaryJoin": {
                        "next": [
                            "Event_MercenaryJoinCancel"
                        ]
                    }
                }
            }
        ],
        "default_case": "No"
    },
