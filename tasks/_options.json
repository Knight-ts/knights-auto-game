{
    "DailyTaskSubTaskSwitch": {
        "type": "checkbox",
        "description": "是否自动处理每日任务",
        "cases": [
            {
                "name": "购买市场折扣物品",
                "description": "是否自动购买市场折扣物品",
                "pipeline_override": {
                    "BigMapMarket": {
                        "enabled": true
                    }
                }
            },
            {
                "name": "商城免费礼包",
                "description": "是否自动购买商城免费礼包",
                "pipeline_override": {
                    "BigMapMall": {
                        "enabled": true
                    }
                }
            },
            {
                "name": "悬赏令领取",
                "description": "是否自动领取悬赏令",
                "pipeline_override": {
                    "BigMapRewardToken": {
                        "enabled": true
                    }
                }
            }
        ],
        "default_case": [
            "购买市场折扣物品",
            "商城免费礼包",
            "悬赏令领取"
        ]
    },
    "4月城堡相亲": {
        "type": "select",
        "description": "4月城堡相亲（城堡-城堡主厅-联姻）：自动 / 跳过 / 手动",
        "default_case": "自动",
        "cases": [
            {
                "name": "自动",
                "description": "自动执行城堡主厅相亲",
                "pipeline_override": {
                    "Flag_EnableAprCastleMarry": {
                        "enabled": true
                    },
                    "Flag_AprCastleManual": {
                        "enabled": false
                    }
                }
            },
            {
                "name": "跳过",
                "description": "4月不做相亲",
                "pipeline_override": {
                    "Flag_EnableAprCastleMarry": {
                        "enabled": false
                    },
                    "Flag_AprCastleManual": {
                        "enabled": false
                    }
                }
            },
            {
                "name": "手动",
                "description": "弹窗提示并暂停任务，由玩家手动处理",
                "pipeline_override": {
                    "Flag_EnableAprCastleMarry": {
                        "enabled": false
                    },
                    "Flag_AprCastleManual": {
                        "enabled": true
                    }
                }
            }
        ]
    },
    "5月春林节相亲": {
        "type": "select",
        "description": "5月春林节相亲暂未实现自动流程，只能选择 跳过 / 手动",
        "default_case": "跳过",
        "cases": [
            {
                "name": "跳过",
                "description": "5月春林节不做相亲，继续推月",
                "pipeline_override": {
                    "Flag_EnableMaySpringMarry": {
                        "enabled": false
                    },
                    "Flag_MaySpringManual": {
                        "enabled": false
                    }
                }
            },
            {
                "name": "手动",
                "description": "弹窗提示并暂停任务，由玩家手动处理",
                "pipeline_override": {
                    "Flag_EnableMaySpringMarry": {
                        "enabled": false
                    },
                    "Flag_MaySpringManual": {
                        "enabled": true
                    }
                }
            }
        ]
    },
    "开启3月启航节购买": {
        "type": "switch",
        "description": "是否开启3月启航节自动购买物品",
        "cases": [
            {
                "name": "Yes",
                "description": "开启3月启航节自动购买",
                "pipeline_override": {
                    "Flag_EnableSailingFestivalPurchase": {
                        "enabled": true
                    }
                }
            },
            {
                "name": "No",
                "description": "关闭3月启航节自动购买",
                "pipeline_override": {
                    "Flag_EnableSailingFestivalPurchase": {
                        "enabled": false
                    }
                }
