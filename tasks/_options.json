{
    "城堡被攻打处理": {
        "type": "select",
        "description": "检测到「一座城堡被攻打」时怎么处理：前往防守会进入防守战并打完；忽略只关闭事件",
        "default_case": "前往防守",
        "cases": [
            {
                "name": "前往防守",
                "description": "点横幅 → 防守 → 出战，交给主动战斗打完并回大地图",
                "pipeline_override": {
                    "CastleDefenseSelect": {
                        "expected": "defend"
                    }
                }
            },
            {
                "name": "忽略",
                "description": "点忽略/关闭，放弃本次防守（找不到按钮会按返回退出）",
                "pipeline_override": {
                    "CastleDefenseSelect": {
                        "expected": "ignore"
                    }
                }
            }
        ]
    },
    "海盗事件处理": {
        "type": "select",
        "description": "检测到「海盗正在袭扰庄园」时怎么处理：自动战斗会跨图去群岛打完；停下等手动会留下标记并暂停任务，玩家调整阵容后再手动处理",
        "default_case": "自动战斗",
        "cases": [
            {
                "name": "自动战斗",
                "description": "跨图前往群岛，自动战斗并回到大陆",
                "pipeline_override": {
                    "PirateSelect": {
                        "expected": "auto"
                    }
                }
            },
            {
                "name": "停下等手动",
                "description": "暂停任务并留下临时标记，玩家调整阵容后手动打（或重新运行组合）",
                "pipeline_override": {
                    "PirateSelect": {
                        "expected": "manual"
                    }
                }
            }
        ]
    },
    "战斗模式": {
        "type": "select",
        "description": "待机模式只结束回合等敌人过来；追击模式主动建图、接近并攻击；自动 = 先待机 N 回合再转追击",
        "default_case": "自动（先待机后追击）",
        "cases": [
            {
                "name": "自动（先待机后追击）",
                "description": "先待机「待机回合数」个回合，之后自动转入追击模式",
                "pipeline_override": {
                    "FightModeSelect": {
                        "expected": "auto"
                    }
                }
            },
            {
                "name": "只待机",
                "description": "整场只点结束回合，靠游戏自动反击；敌人始终不过来时会一直等到安全上限",
                "pipeline_override": {
                    "FightModeSelect": {
                        "expected": "standby"
                    }
                }
            },
            {
                "name": "只追击",
                "description": "第 1 回合就建图搜索、粗方向推进并主动攻击",
                "pipeline_override": {
                    "FightModeSelect": {
                        "expected": "pursuit"
                    }
                }
            }
        ]
    },
    "待机回合数": {
        "type": "input",
        "description": "自动模式下先待机的回合数，0 = 立刻进入追击模式。回合数按整场战斗累计，恢复调用不会重新计数。",
        "inputs": [
            {
                "name": "回合数",
                "description": "待机回合数，0 表示不待机直接追击",
                "default": "20",
                "pipeline_type": "string",
                "verify": "^[0-9]*$",
                "pattern_msg": "只能填数字，留空按默认 20 处理"
            }
        ],
        "pipeline_override": {
            "FightStandbyRounds": {
                "expected": [
                    "{回合数}"
                ]
            }
        }
    },
    "棋子识别": {
        "type": "select",
        "description": "战斗中识别选中棋子的名字、技能与实测攻击/移动范围，输出到日志和 table/piece_observations.json",
        "default_case": "开启",
        "cases": [
            {
                "name": "开启",
                "description": "选中棋子时读取人物卡文字并实测攻击范围，可用于补齐被遮挡的攻击目标",
                "pipeline_override": {
                    "FightPieceRecognition": {
                        "expected": "on"
                    }
                }
            },
            {
                "name": "关闭",
                "description": "关闭后不读人物卡、不写观测表，攻击仍只按黄色角标判断",
                "pipeline_override": {
                    "FightPieceRecognition": {
                        "expected": "off"
                    }
                }
            }
        ]
    },
