                "pipeline_override": {
                    "Flag_AutoNameChild": {
                        "enabled": true
                    }
                }
            },
            {
                "name": "No",
                "description": "关闭自动起名：直接点确认，保留游戏默认名字",
                "pipeline_override": {
                    "Flag_AutoNameChild": {
                        "enabled": false
                    }
                }
            }
        ],
        "default_case": "Yes"
    },
    "开启自动接受佣兵": {
        "type": "select",
        "description": "自动接受加入的佣兵：全部接受 / 智能接受（按名字规则） / 不自动接受",
        "cases": [
            {
                "name": "No",
                "description": "不自动接受：直接点取消",
                "pipeline_override": {
                    "Flag_SmartMercenary": {
                        "enabled": false
                    },
                    "Event_MercenaryJoin": {
                        "next": [
                            "Event_MercenaryJoinCancel"
                        ]
                    }
                }
            },
            {
                "name": "Yes",
                "description": "全部接受：直接点招募",
                "pipeline_override": {
                    "Flag_SmartMercenary": {
                        "enabled": false
                    },
                    "Event_MercenaryJoin": {
                        "next": [
                            "Event_MercenaryJoinConfirm"
                        ]
                    }
                }
            },
            {
                "name": "智能",
                "description": "智能接受：佣兵名字命中 table/mercenary_rules.json 才接受",
                "pipeline_override": {
                    "Flag_SmartMercenary": {
                        "enabled": true
                    },
                    "Event_MercenaryJoin": {
                        "next": [
                            "Event_MercenaryJoinCancel"
                        ]
                    }
                }
            }
        ],
        "default_case": "No"
    },
